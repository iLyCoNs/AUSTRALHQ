{
  "_comment": "AustralDrone.CL — CEO Jaime Avatar Sprite Sheet Configuration v1.0",
  "meta": {
    "image": "CEO.png",
    "character": "CEO Jaime",
    "app": "AustralDrone.CL Virtual Office",
    "version": "1.0.0",
    "totalRows": 4,
    "maxCols": 12,
    "frameWidthAuto": true,
    "frameHeightAuto": true,
    "_note": "frameWidth = image.naturalWidth / maxCols | frameHeight = image.naturalHeight / totalRows"
  },

  "animations": {
    "idle": {
      "row": 0,
      "frameCount": 12,
      "startFrame": 0,
      "endFrame": 11,
      "fps": 10,
      "loop": true,
      "trigger": "default",
      "priority": 0,
      "description": "Estado por defecto — CEO en reposo, leve respiración y movimiento de ojos"
    },
    "walk": {
      "row": 1,
      "frameCount": 10,
      "startFrame": 0,
      "endFrame": 9,
      "fps": 12,
      "loop": true,
      "trigger": "moving",
      "priority": 1,
      "description": "CEO camina hacia un destino en la oficina"
    },
    "work": {
      "row": 2,
      "frameCount": 8,
      "startFrame": 0,
      "endFrame": 7,
      "fps": 10,
      "loop": true,
      "trigger": "scraping_active",
      "autoReturnToIdle": true,
      "autoReturnDelay": 10000,
      "priority": 2,
      "description": "CEO trabajando intensamente — scraping / análisis IA activo"
    },
    "celebrate": {
      "row": 3,
      "frameCount": 8,
      "startFrame": 0,
      "endFrame": 7,
      "fps": 12,
      "loop": false,
      "trigger": "lead_qualified",
      "onComplete": "idle",
      "priority": 3,
      "description": "CEO celebra conversión B2B exitosa o prospecto calificado"
    }
  },

  "webhookEventMap": {
    "moving": "walk",
    "scraping_active": "work",
    "lead_qualified": "celebrate",
    "idle": "idle",
    "legal_query": "work",
    "webhook_received": "work",
    "party": "celebrate",
    "new_lead": "work",
    "conversion": "celebrate",
    "report_received": "work",
    "meta_ad_found": "work",
    "yapo_scan": "work",
    "wsp_sent": "celebrate"
  },

  "phaser3": {
    "_comment": "Config compatible con Phaser 3 AnimationManager — usar con scene.load.spritesheet()",
    "_usage": "scene.load.spritesheet('ceo', 'sprites/CEO.png', { frameWidth: X, frameHeight: Y })",
    "animations": [
      {
        "key": "ceo-idle",
        "frames": { "start": 0,  "end": 11 },
        "frameRate": 10,
        "repeat": -1
      },
      {
        "key": "ceo-walk",
        "frames": { "start": 12, "end": 21 },
        "frameRate": 12,
        "repeat": -1
      },
      {
        "key": "ceo-work",
        "frames": { "start": 22, "end": 29 },
        "frameRate": 10,
        "repeat": -1
      },
      {
        "key": "ceo-celebrate",
        "frames": { "start": 30, "end": 37 },
        "frameRate": 12,
        "repeat": 0
      }
    ]
  },

  "n8n": {
    "webhookPath": "/webhook/ceo-avatar-state",
    "wsPath": "/webhook-ws/ceo-avatar",
    "port": 5678,
    "baseUrl": "http://localhost:5678",
    "expectedPayload": {
      "action": "string (moving | scraping_active | lead_qualified | idle | ...)",
      "destination": "string 'x,y' — solo si action=moving",
      "leadName": "string — nombre del prospecto (action=lead_qualified)",
      "metadata": "object — datos adicionales opcionales"
    },
    "examplePayloads": [
      { "action": "scraping_active", "source": "cazador_360_vendedores.py" },
      { "action": "lead_qualified", "leadName": "Carlos Méndez — 145 Has Alerce", "via": "WhatsApp" },
      { "action": "moving", "destination": "680,290" },
      { "action": "idle" }
    ]
  }
}
